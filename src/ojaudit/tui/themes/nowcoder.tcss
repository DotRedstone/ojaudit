/* ojaudit 界面样式：唯一样式来源。
   结构：顶栏(#breadcrumb) / 内容(#body) / 按键提示栏(#status)。
   颜色全部使用主题变量，跟随壁纸或内置主题切换。 */

Screen {
    layout: vertical;
    background: $background;
    color: $foreground;
}
/* 弹窗与搜索行叠在当前页面之上，不遮挡背景（lazygit / nvim 的浮窗习惯）。 */
Popup, SearchLine { background: transparent; }

/* ── 外壳 ───────────────────────────────────────── */

#breadcrumb {
    height: 1;
    padding: 0 1;
    background: $surface;
}
#breadcrumb:hover { background: $surface-lighten-1; }

#body {
    height: 1fr;
    padding: 1 2 0 2;
}

#heading {
    height: 2;
    padding: 0 1;
}

#status {
    height: 1;
    padding: 0 1;
    background: $surface;
}

.panel {
    border: $border-style $panel;
    border-title-color: $text-muted;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $background;
    padding: 0 1;
}
.panel:focus-within {
    border: $border-style $primary;
    border-title-color: $primary;
}

/* ── 列表与表格 ─────────────────────────────────── */

.thead {
    height: 1;
    padding: 0 2;
    margin-bottom: 0;
}

ListView {
    height: 1fr;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-color: $panel;
}
ListView:focus { background-tint: $background 0%; }
ListItem {
    padding: 0 1;
    background: $background;
    color: $foreground;
    border-left: blank;
}
ListItem.-hovered { background: $primary 8%; }
ListView > ListItem.-highlight {
    background: $panel 40%;
    border-left: outer $panel;
    text-style: none;
}
ListView:focus > ListItem.-highlight {
    background: $primary 15%;
    border-left: outer $primary;
}

#filters { height: 2; padding: 0 1; }

/* ── 首页 ───────────────────────────────────────── */

#hero { height: 3; padding: 0 1; }
#home-columns { height: auto; max-height: 12; }
#home-menu { width: 46; height: 10; }
#home-menu ListView { height: auto; }
#home-overview { width: 1fr; height: 10; padding: 1 2; }
#empty-guide { height: auto; margin-top: 1; padding: 0 1; color: $warning; }
#home-recent { height: auto; max-height: 12; margin-top: 1; padding: 0 1; }

/* ── 比赛总览 ───────────────────────────────────── */

#cards { height: 4; margin-bottom: 1; }
.card {
    width: 1fr;
    height: 4;
    margin-right: 1;
    padding: 0 2;
    border: $border-style $panel;
    background: $background;
}
#card-3 { width: 2fr; }
#card-4 { width: 2fr; margin-right: 0; }
#summary { display: none; }
#overview-options { height: auto; max-height: 8; }

/* ── 证据与代码 ─────────────────────────────────── */

#evidence-head { height: 3; padding: 0 1; }
#evidence-meta {
    height: auto;
    max-height: 6;
    margin-bottom: 1;
    padding: 0 1;
}
#code-pair { height: 1fr; }
.source-pane {
    width: 1fr;
    height: 1fr;
    border: $border-style $panel;
    border-title-color: $foreground;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $background;
    scrollbar-size: 1 1;
    scrollbar-background: $background;
    scrollbar-color: $panel;
}
#pane-left { width: 1fr; }
#pane-right { width: 1fr; }
.source-pane:focus { border: $border-style $primary; }
#code-left, #code-right, #code-body { width: auto; }
#code-meta { height: 2; padding: 0 1; }

/* ── 设置 ───────────────────────────────────────── */

#settings-columns { height: 1fr; }
#categories { width: 22; height: 1fr; }
#options-pane { width: 1fr; height: 1fr; }
#settings-values { height: 1fr; }
#settings-detail {
    height: 5;
    padding: 0 1;
    border-top: solid $panel;
}

/* ── 排行榜 ─────────────────────────────────────── */

#ranking-columns { height: 1fr; }
#ranking-side { width: 44; }
#ranking-options { height: 8; }
#ranking-warning { height: auto; margin-top: 1; padding: 0 1; }
#ranking-main { width: 1fr; height: 1fr; }
#ranking-main .thead { padding: 0 2; }

/* ── 账户 ───────────────────────────────────────── */

#account-state { height: 7; max-width: 80; padding: 1 2; margin-bottom: 1; }

/* ── 弹窗：lazygit 风格，标题在上边框、提示在下边框，无按钮、无遮罩 ── */

.popup {
    height: auto;
    max-width: 90%;
    max-height: 80%;
    padding: 0 1;
    border: $border-style $primary;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $background;
}
.popup.warning { border: $border-style $warning; border-title-color: $warning; }
.popup-input, .popup Input {
    border: none;
    height: 1;
    padding: 0;
    margin: 0;
    background: $background;
}
.popup Input:focus { background: $primary 12%; }
.popup-note { color: $text-muted; height: auto; }
.popup-message { height: auto; padding: 0 0 0 0; }
.popup ListView { height: auto; max-height: 16; background: $background; }
.popup #note { margin-top: 1; }

#style-help { height: auto; }
#qr-code { height: auto; margin: 1 0 0 0; }
#qr-wrap { height: auto; align-horizontal: center; }
#qr-status { height: auto; margin-top: 1; }

/* 设置页的分组标题行不参与高亮 */
ListView > ListItem.section { padding-top: 0; }
ListView > ListItem.section.-highlight { background: $background; border-left: blank; }

Input { background: $background; border: none; height: 1; padding: 0; }

/* ── ANSI / 透明背景模式：只用终端 16 色，不做半透明叠色 ── */

App.-ansi ListView > ListItem.-highlight { background: ansi_default; border-left: outer ansi_bright_black; }
App.-ansi ListView:focus > ListItem.-highlight { background: ansi_bright_black; border-left: outer ansi_blue; }
App.-ansi ListItem.-hovered { background: ansi_default; }
App.-ansi ListView, App.-ansi .source-pane {
    scrollbar-background: ansi_default;
    scrollbar-color: ansi_bright_black;
    scrollbar-color-hover: ansi_white;
    scrollbar-color-active: ansi_white;
}
App.-ansi #breadcrumb, App.-ansi #status, App.-ansi SearchLine > #search-line,
App.-ansi SearchLine Input { background: ansi_default; }
App.-ansi .popup Input:focus { background: ansi_default; }
